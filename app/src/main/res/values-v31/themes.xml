<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Noor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#0B1B3A</item>
        <item name="android:navigationBarColor">#0B1B3A</item>
        <item name="android:windowBackground">#0B1B3A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <!-- Android 12+ mandates its own splash screen; make it navy, not white -->
        <item name="android:windowSplashScreenBackground">#0B1B3A</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0B1B3A</item>
    </style>
</resources>
