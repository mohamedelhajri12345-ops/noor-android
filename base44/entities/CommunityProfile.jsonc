{
  "name": "CommunityProfile",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0639\u0631\u0641"
    },
    "display_name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645"
    },
    "avatar_url": {
      "type": "string",
      "title": "\u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0634\u062e\u0635\u064a\u0629"
    },
    "user_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    }
  },
  "required": [
    "handle",
    "display_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
