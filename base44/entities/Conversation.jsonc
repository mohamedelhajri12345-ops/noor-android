{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "group"
      ],
      "default": "direct"
    },
    "member_handles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0645\u0639\u0631\u0641\u0627\u062a \u0627\u0644\u0623\u0639\u0636\u0627\u0621"
    },
    "member_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0623\u0639\u0636\u0627\u0621"
    },
    "member_avatars": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0635\u0648\u0631 \u0627\u0644\u0623\u0639\u0636\u0627\u0621"
    },
    "avatar_url": {
      "type": "string",
      "title": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629"
    },
    "last_message": {
      "type": "string",
      "title": "\u0622\u062e\u0631 \u0631\u0633\u0627\u0644\u0629"
    },
    "last_message_time": {
      "type": "string",
      "format": "date-time",
      "title": "\u0648\u0642\u062a \u0622\u062e\u0631 \u0631\u0633\u0627\u0644\u0629"
    },
    "last_sender": {
      "type": "string",
      "title": "\u0622\u062e\u0631 \u0645\u0631\u0633\u0644"
    }
  },
  "required": [
    "name",
    "type",
    "member_handles"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
