{
  "name": "CommunityMessage",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u0639\u0627\u0631"
    },
    "conversation_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629"
    },
    "text": {
      "type": "string",
      "title": "\u0627\u0644\u0646\u0635"
    },
    "file_url": {
      "type": "string",
      "title": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0645\u0644\u0641"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "audio",
        "voice",
        "image"
      ],
      "default": "audio"
    },
    "avatar_url": {
      "type": "string",
      "title": "\u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0634\u062e\u0635\u064a\u0629"
    },
    "edited": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "nickname",
    "text"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
